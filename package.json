{
  "name": "daily-chunk",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "npm run start -w @daily-chunk/app",
    "web": "npm run web -w @daily-chunk/app",
    "android": "npm run android -w @daily-chunk/app",
    "storybook": "npm run storybook -w @daily-chunk/app",
    "test": "nx run-many -t test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "nx": "^21.0.0",
    "prettier": "^3.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.1.0"
  }
}
